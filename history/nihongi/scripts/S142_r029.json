  {
   "id": "n01",
   "narration": "家康に会った数が見えたら、一番は家臣でなく外国人。"
  },
  {
   "id": "n02",
   "narration": "1600年、関ヶ原の半年前。"
  },
  {
   "id": "n03",
   "narration": "豊後の沖に、オランダ船が流れ着く。"
  },
  {
   "id": "n04",
   "narration": "イギリス人の航海士アダムス。"
  },
  {
   "id": "n05",
   "narration": "頭の上の会った数は、まだ0。"
  },
  {
   "id": "n06",
   "narration": "大坂城で、家康が彼に会う。"
  },
  {
   "id": "n07",
   "narration": "数字は1、2、5と増えていく。"
  },
  {
   "id": "n08",
   "narration": "伊豆の伊東で、西洋の帆船も造った。"
  },
  {
   "id": "n09",
   "narration": "相模の逸見に250石。旗本になったとされる。"
  },
  {
   "id": "n10",
   "narration": "名は三浦按針。船の水先案内という意味。"
  },
  {
   "id": "n11",
   "narration": "古い家臣たちは、異国の男をにらむ。"
  },
  {
   "id": "n12",
   "narration": "なぜ殿のそばに、あの者が。"
  },
  {
   "id": "n13",
   "narration": "広間の頭の上は、1桁ばかり。按針だけが3桁。"
  },
  {
   "id": "n14",
   "narration": "按針を呼べ。"
  },
  {
   "id": "n15",
   "narration": "その夜、按針の屋敷に大名の家来の列。"
  },
  {
   "id": "n16",
   "narration": "家康への取り次ぎを頼みに。"
  },
  {
   "id": "n17",
   "narration": "実際も、按針は家康の外交の相談役とされる。"
  },
  {
   "id": "n18",
   "narration": "逸見は今の横須賀。丘の上に按針塚が残る。"
  },
  {
   "id": "n19",
   "narration": "あなたなら、どこで歴史を変える？コメントで教えて。"
  }
 ],
